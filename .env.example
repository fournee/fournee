# Copy to .env (never committed) only if you need these. Everything works without them.
# ELECTRON_PATH=C:/path/to/electron.exe   # delivery/test/electron.mjs: an Electron to test with (skipped if unset)
# MISE_TEST_FONTS=C:/path/to/fonts        # kitchen/test/panel-browser.mjs: a folder with alegreya-sans-latin-{500,700,800}-normal.woff2 for the add-your-own-font test (skipped if unset)
# FOURNEE_PRIVATE_WORDS=clientname|internalproject   # .githooks/pre-commit blocks commits that add these words (enable: git config core.hooksPath .githooks)
