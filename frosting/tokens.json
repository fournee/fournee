{
  "version": "1.0.0",
  "prefix": "fr",
  "about": "The frosting role list. This file is the single source of truth: the CSS, the gallery's derive(), the readability checks, the catalog page and the spec all read from it. Add a role here, nowhere else.",
  "groups": {
    "core": "Always present. Every frosted page uses these.",
    "status": "Optional. Dashboards and monitors: dots, meters, badges.",
    "series": "Optional. Chart lines and bars, in order of use."
  },
  "roles": [
    { "name": "bg",             "group": "core",   "label": "Background",     "use": "The page or window background.",                               "light": "#FFFFFF", "dark": "#0F1115" },
    { "name": "surface",        "group": "core",   "label": "Surface",        "use": "Cards, panels, soft surfaces that sit on the background.",     "light": "#F5F3EF", "dark": "#171A21" },
    { "name": "border",         "group": "core",   "label": "Border",         "use": "Lines, dividers, card edges.",                                 "light": "#E3DED6", "dark": "#262B36" },
    { "name": "text",           "group": "core",   "label": "Text",           "use": "Main reading text.",                                           "light": "#1C1B19", "dark": "#E6E8EE" },
    { "name": "muted",          "group": "core",   "label": "Quiet text",     "use": "Secondary text, labels, captions. Still has to be readable.",  "light": "#5E5A53", "dark": "#8A92A6" },
    { "name": "accent",         "group": "core",   "label": "Accent",         "use": "Shapes, icons, highlights, the logo. Not for body text.",      "light": "#2E7D4F", "dark": "#9D7BFF" },
    { "name": "accent-text",    "group": "core",   "label": "Accent text",    "use": "Accent-coloured text and links. A readable cousin of accent.", "light": "#22603C", "dark": "#B9A3FF" },
    { "name": "button",         "group": "core",   "label": "Button",         "use": "Primary action fill.",                                         "light": "#2E7D4F", "dark": "#9D7BFF" },
    { "name": "button-text",    "group": "core",   "label": "Button text",    "use": "Text on the primary button.",                                  "light": "#FFFFFF", "dark": "#0F1115" },
    { "name": "progress-fill",  "group": "core",   "label": "Progress fill",  "use": "The filled part of meters and progress bars.",                 "light": "#2E7D4F", "dark": "#9D7BFF" },
    { "name": "progress-track", "group": "core",   "label": "Progress track", "use": "The empty part of meters and progress bars.",                  "light": "#E7E3DC", "dark": "#262B36" },

    { "name": "ok",             "group": "status", "label": "OK",             "use": "Healthy, up, done. Dots, meters, badge fills.",                "light": "#2E7D4F", "dark": "#3DDC84" },
    { "name": "warn",           "group": "status", "label": "Warning",        "use": "Needs attention soon.",                                        "light": "#B45309", "dark": "#FFCC4D" },
    { "name": "bad",            "group": "status", "label": "Bad",            "use": "Down, failed, over the line.",                                 "light": "#C8402F", "dark": "#FF5C6C" },

    { "name": "series-1",       "group": "series", "label": "Series 1",       "use": "First chart line or bar.",                                     "light": "#1F5F8B", "dark": "#4FB3FF" },
    { "name": "series-2",       "group": "series", "label": "Series 2",       "use": "Second chart line or bar.",                                    "light": "#D9622B", "dark": "#FFB454" },
    { "name": "series-3",       "group": "series", "label": "Series 3",       "use": "Third chart line or bar.",                                     "light": "#6B2D5C", "dark": "#C084FC" },
    { "name": "series-4",       "group": "series", "label": "Series 4",       "use": "Fourth chart line or bar.",                                    "light": "#5C6B3A", "dark": "#5FE0A8" }
  ],
  "contracts": [
    { "label": "Text on background",      "role": "text",          "against": "bg",             "min": 7 },
    { "label": "Text on surfaces",        "role": "text",          "against": "surface",        "min": 7 },
    { "label": "Quiet text",              "role": "muted",         "against": "bg",             "min": 4.5 },
    { "label": "Quiet text on surfaces",  "role": "muted",         "against": "surface",        "min": 4.5 },
    { "label": "Accent text",             "role": "accent-text",   "against": "bg",             "min": 4.5 },
    { "label": "Accent text on surfaces", "role": "accent-text",   "against": "surface",        "min": 4.5 },
    { "label": "Accent shapes",           "role": "accent",        "against": "bg",             "min": 3 },
    { "label": "Button shape",            "role": "button",        "against": "bg",             "min": 3 },
    { "label": "Button text",             "role": "button-text",   "against": "button",         "min": 4.5 },
    { "label": "Progress bar",            "role": "progress-fill", "against": "progress-track", "min": 3 },
    { "label": "Progress on background",  "role": "progress-fill", "against": "bg",             "min": 3 },

    { "label": "OK dot",                  "role": "ok",            "against": "bg",             "min": 3 },
    { "label": "OK dot on surfaces",      "role": "ok",            "against": "surface",        "min": 3 },
    { "label": "Warning dot",             "role": "warn",          "against": "bg",             "min": 3 },
    { "label": "Warning dot on surfaces", "role": "warn",          "against": "surface",        "min": 3 },
    { "label": "Bad dot",                 "role": "bad",           "against": "bg",             "min": 3 },
    { "label": "Bad dot on surfaces",     "role": "bad",           "against": "surface",        "min": 3 },

    { "label": "Series 1",                "role": "series-1",      "against": "bg",             "min": 3 },
    { "label": "Series 2",                "role": "series-2",      "against": "bg",             "min": 3 },
    { "label": "Series 3",                "role": "series-3",      "against": "bg",             "min": 3 },
    { "label": "Series 4",                "role": "series-4",      "against": "bg",             "min": 3 }
  ],
  "derived": {
    "about": "Follow the roles automatically through color-mix(); never edited directly. {p} is the prefix.",
    "accent-soft":    "color-mix(in srgb, var(--{p}-accent) 12%, var(--{p}-bg))",
    "accent-faint":   "color-mix(in srgb, var(--{p}-accent) 8%, var(--{p}-bg))",
    "control-border": "color-mix(in srgb, var(--{p}-muted) 80%, var(--{p}-bg))",
    "scrim":          "rgb(14 13 12 / .5)",
    "tip-bg":         "var(--{p}-text)",
    "tip-text":       "var(--{p}-bg)",
    "focus-ring":     "var(--{p}-accent)"
  }
}
